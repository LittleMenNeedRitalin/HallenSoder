@inject SiteContent C

<ul class="hours">
    @for (var i = 1; i <= 4; i++)
    {
        var label = C[$"hours.{i}.label"];
        var value = C[$"hours.{i}.value"];
        if (!string.IsNullOrWhiteSpace(label) || !string.IsNullOrWhiteSpace(value))
        {
            <li class="@(i > 2 ? "sub" : "")"><span>@label</span><strong><Multiline Text="@value" /></strong></li>
        }
    }
</ul>
