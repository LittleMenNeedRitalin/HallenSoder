@page "/boka-bord"
@inherits SitePage
@inject SiteContent C

<PageTitle>Boka bord – Hallen Södermalm</PageTitle>

<section class="page-hero">
    <div class="wrap">
        <span class="eyebrow">Möt upp</span>
        <h2>Boka bord</h2>
        <p class="lead" style="margin-top:1rem"><Multiline Text="@C["booking.intro"]" /></p>
    </div>
</section>

<section style="padding-top:3rem">
    <div class="wrap booking-grid">
        <div class="reveal">
            @if (!string.IsNullOrWhiteSpace(C["booking.notice"]))
            {
                <div class="alert"><strong>Observera:</strong> <Multiline Text="@C["booking.notice"]" /></div>
            }
            <div class="iframe-box"><iframe src="https://widget.thefork.com/sv/550750af-69ba-4857-9dee-b3fa04c2f0ba" title="Boka bord via TheFork" loading="lazy"></iframe></div>
        </div>
        <aside class="panel reveal">
            <h3>@C["booking.side_title"]</h3>
            <ul class="list" style="margin-top:1.2rem">
                <li><small>Telefon</small><a href="tel:@SiteContent.Digits(C["contact.phone"])">@C["contact.phone"]</a></li>
                <li><small>E-post</small><a href="mailto:@C["contact.email"]">@C["contact.email"]</a></li>
                <li><small>Adress</small><Multiline Text="@C["contact.address"]" /></li>
            </ul>
            <p style="margin-top:1.5rem;color:var(--muted)"><Multiline Text="@C["booking.side_text"]" /></p>
        </aside>
    </div>
</section>
