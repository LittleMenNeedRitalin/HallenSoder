@page "/"
@inherits SitePage
@inject EventService Events
@inject SiteContent C

<PageTitle>Hallen Södermalm – Sportsbar på Götgatan</PageTitle>

<section class="hero">
    <div class="wrap">
        <span class="eyebrow">@C["hero.eyebrow"]</span>
        <h1>@C["hero.title1"]<span>@C["hero.title2"]</span></h1>
        <p class="lead"><Multiline Text="@C["hero.lead"]" /></p>
        <div class="hero-cta">
            <a class="btn btn-primary" href="boka-bord">Boka bord</a>
            <a class="btn btn-ghost" href="meny">Se menyn</a>
        </div>
    </div>
</section>

<div class="strip">
    <div class="wrap">
        <div class="strip-item"><span class="ico">📍</span><div><small>Hitta hit</small><strong>@C["strip.address"]</strong></div></div>
        <div class="strip-item"><span class="ico">📺</span><div><small>På skärmarna</small><strong>@C["strip.sport"]</strong></div></div>
        <div class="strip-item"><span class="ico">🕐</span><div><small>Öppettider</small><strong>@C["strip.hours"]</strong></div></div>
        <div class="strip-item"><span class="ico">🍔</span><div><small>@C["strip.lunch_label"]</small><strong>@C["strip.lunch"]</strong></div></div>
    </div>
</div>

<section>
    <div class="wrap split">
        <div class="reveal">
            <span class="eyebrow">@C["about.eyebrow"]</span>
            <h2>@C["about.title"]</h2>
            <p class="lead"><Multiline Text="@C["about.lead"]" /></p>
            <a class="btn btn-ghost" href="kontakt">Hitta hit</a>
        </div>
        <img class="reveal" src="img/bar-counter.webp" alt="Baren på Hallen med skärmar och hängande glas" loading="lazy">
    </div>
</section>

<section style="background:var(--bg-2)">
    <div class="wrap">
        <div class="section-head reveal"><span class="eyebrow">Upptäck</span><h2>Mat, dryck &amp; matcher</h2></div>
        <div class="cards">
            <a class="card reveal" href="meny">
                <img src="img/food.webp" alt="Meaty fries och burgare" loading="lazy">
                <div class="card-body"><h3>@C["card1.title"]</h3><p><Multiline Text="@C["card1.text"]" /></p><span class="card-link">Se vår meny</span></div>
            </a>
            <a class="card reveal" href="meny#dessertdrinkar">
                <img src="img/drink.webp" alt="Aperol Spritz på bardisken" loading="lazy">
                <div class="card-body"><h3>@C["card2.title"]</h3><p><Multiline Text="@C["card2.text"]" /></p><span class="card-link">Dryckesmeny</span></div>
            </a>
            <a class="card reveal" href="evenemang">
                <img src="img/interior-lounge.webp" alt="Lokalen med soffor och storbildsskärmar" loading="lazy">
                <div class="card-body"><h3>@C["card3.title"]</h3><p><Multiline Text="@C["card3.text"]" /></p><span class="card-link">Se schemat</span></div>
            </a>
        </div>
    </div>
</section>

<section>
    <div class="wrap">
        <div class="section-head row reveal">
            <div><span class="eyebrow">På gång</span><h2>Kommande event</h2></div>
            <a class="btn btn-ghost" href="evenemang">Hela schemat</a>
        </div>
        <div class="events">
            @if (upcoming is null)
            {
                <p class="lead">Laddar…</p>
            }
            else if (upcoming.Count == 0)
            {
                <p class="lead">Inga kommande event just nu.</p>
            }
            else
            {
                @foreach (var e in upcoming)
                {
                    <EventCard Event="e" />
                }
            }
        </div>
    </div>
</section>

<section>
    <div class="wrap">
        <div class="section-head reveal"><span class="eyebrow">Stämningen</span><h2>Kika in hos oss</h2></div>
        <div class="gallery reveal">
            <img class="wide" src="img/interior-bar.webp" alt="Hallens bar och lokal" loading="lazy">
            <img class="tall" src="img/interior-dark.webp" alt="Barstolar och soffor mot entrén" loading="lazy">
            <img src="img/drink.webp" alt="Aperol Spritz" loading="lazy">
            <img src="img/food.webp" alt="Meaty fries" loading="lazy">
            <img class="wide" src="img/interior-lounge.webp" alt="Soffgrupper och bar" loading="lazy">
        </div>
    </div>
</section>

<section class="band">
    <div class="wrap reveal">
        <span class="eyebrow">@C["afterwork.eyebrow"]</span>
        <h2>@C["afterwork.title"]</h2>
        <p class="lead"><Multiline Text="@C["afterwork.lead"]" /></p>
        @if (!string.IsNullOrWhiteSpace(C["afterwork.happy"]))
        {
            <p class="happy">@C["afterwork.happy"]</p>
        }
        <a class="btn btn-primary" href="boka-bord">Boka bord</a>
    </div>
</section>

@code {
    private List<SiteEvent>? upcoming;

    protected override async Task OnInitializedAsync()
    {
        var all = await Events.GetUpcomingAsync();
        // Utvalda event först, därefter närmast i tid – max tre, sorterade på datum.
        upcoming = all.OrderByDescending(e => e.Featured).ThenBy(e => e.Date)
                      .Take(3).OrderBy(e => e.Date).ToList();
    }
}
