@page "/kontakt"
@inherits SitePage
@inject SiteContent C

<PageTitle>Hitta hit – Hallen Södermalm</PageTitle>

<section class="page-hero">
    <div class="wrap">
        <span class="eyebrow">Kontakt</span>
        <h2>Hitta hit</h2>
        <p class="lead" style="margin-top:1rem"><Multiline Text="@C["contact.intro"]" /></p>
    </div>
</section>

<section style="padding-top:3rem">
    <div class="wrap contact-grid">
        <div class="panel reveal">
            <h3>Hallen Södermalm</h3>
            <ul class="list" style="margin-top:1.4rem">
                <li><small>Adress</small><Multiline Text="@C["contact.address"]" /></li>
                <li><small>Telefon</small><a href="tel:@SiteContent.Digits(C["contact.phone"])">@C["contact.phone"]</a></li>
                <li><small>E-post</small><a href="mailto:@C["contact.email"]">@C["contact.email"]</a></li>
            </ul>
            <h3 style="margin-top:2rem">Öppettider</h3>
            <div style="margin-top:1rem"><OpeningHours /></div>
            <p style="margin-top:2rem"><a class="btn btn-primary" href="boka-bord">Boka bord</a></p>
        </div>
        <div class="map reveal">
            <iframe title="Karta till Hallen Södermalm" loading="lazy" src="https://maps.google.com/maps?q=G%C3%B6tgatan%2085A%20116%2062%20Stockholm&amp;t=m&amp;z=15&amp;output=embed&amp;iwloc=near"></iframe>
        </div>
    </div>
</section>
