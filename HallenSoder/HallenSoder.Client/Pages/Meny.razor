@page "/meny"
@inherits SitePage
@implements IAsyncDisposable
@inject MenuService Menu
@inject SiteContent C

<PageTitle>Meny – Hallen Södermalm</PageTitle>

<section class="page-hero">
    <div class="wrap">
        <span class="eyebrow">Upptäck</span>
        <h2>@C["menu.title"]</h2>
        <p class="lead" style="margin-top:1rem"><Multiline Text="@C["menu.intro"]" /></p>
    </div>
</section>

@if (sections is null)
{
    <section><div class="wrap"><p class="lead">Laddar menyn…</p></div></section>
}
else
{
    <div class="menu-tabs">
        <div class="wrap">
            <div class="tabs-inner">
                @foreach (var s in sections)
                {
                    <button class="tab @(s.Slug == active ? "active" : "")" @onclick="() => ScrollTo(s.Slug)">@s.Title</button>
                }
            </div>
        </div>
    </div>

    <section style="padding-top:0">
        <div class="wrap">
            @foreach (var s in sections)
            {
                <section class="menu-section" id="@s.Slug">
                    <h2>@s.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(s.Note))
                    {
                        <p class="note">@s.Note</p>
                    }
                    <div class="menu-grid">
                        @foreach (var d in s.Items)
                        {
                            <article class="dish">
                                <div class="dish-top">
                                    <h3>@d.Name</h3>
                                    @if (d.Price is not null)
                                    {
                                        <span class="price">@d.Price kr</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(d.Description))
                                {
                                    <p>@d.Description</p>
                                }
                            </article>
                        }
                    </div>
                </section>
            }

            <div class="menu-banner"><img src="img/food.webp" alt="Meaty fries och burgare" loading="lazy"></div>
            <p class="menu-foot"><Multiline Text="@C["menu.footer"]" /></p>
            <p style="margin-top:2rem"><a class="btn btn-primary" href="boka-bord">Boka bord</a></p>
        </div>
    </section>
}

@code {
    private List<MenuSectionRow>? sections;
    private string active = "";
    private bool spyStarted;
    private DotNetObjectReference<Meny>? self;

    protected override async Task OnInitializedAsync()
    {
        var rows = await Menu.GetAsync(includeHidden: false);
        // Tom eller otillgänglig databas: använd standardmenyn så att sidan aldrig blir tom.
        sections = rows is { Count: > 0 } ? rows : MenuData.ToRows();
        active = sections[0].Slug;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (sections is not null && !spyStarted)
        {
            spyStarted = true;
            self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("hallen.initMenuSpy", self);
        }
    }

    private Task ScrollTo(string id) => JS.InvokeVoidAsync("hallen.scrollToId", id).AsTask();

    [JSInvokable]
    public async Task SetActive(string id)
    {
        if (id == active) return;
        active = id;
        StateHasChanged();
        await JS.InvokeVoidAsync("hallen.scrollTabIntoView");
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("hallen.disposeMenuSpy"); } catch (JSDisconnectedException) { }
        self?.Dispose();
    }
}
